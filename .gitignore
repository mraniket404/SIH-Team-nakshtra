# ==========================================
# SatQuery AI - Git Ignore
# ==========================================

# ---------- Environment ----------
.env
.env.*
!.env.example

# ---------- Node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- Frontend ----------
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# ---------- Backend ----------
backend/node_modules/
backend/dist/
backend/logs/

# ---------- Python ----------
ml/venv/
ml/.venv/
__pycache__/
*.py[cod]
*$py.class

# ---------- Python cache ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Uploaded Satellite Data ----------
backend/uploads/*
!backend/uploads/.gitkeep

# ---------- ML Generated Outputs ----------
ml/outputs/*
!ml/outputs/.gitkeep

# ---------- Generated Raster Files ----------
*.tif
*.tiff
*.geotiff

# ---------- Generated Images ----------
*.png
*.jpg
*.jpeg

# ---------- Reports ----------
*.pdf

# ---------- Temporary Files ----------
*.tmp
*.temp
*.log

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- VS Code ----------
.vscode/
!.vscode/settings.json

# ---------- IntelliJ / JetBrains ----------
.idea/
*.iml

# ---------- Windows ----------
*.lnk


# ==========================================
# Satellite / ML datasets and raw products
# ==========================================

ml/*.zip
ml/*.tar.gz
ml/*.csv
ml/*.parquet
ml/*token*.txt

# Sentinel satellite product
ml/sentinel_product/

# Downloaded datasets / archives
ml/data/
ml/datasets/
ml/raw/
ml/test_data/
*.tif
*.tiff
*.jp2
cdse_token.txt
